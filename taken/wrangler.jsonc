// De taken-Worker: alleen geplande taken, zonder de Next-app (Bouwbesluiten 3.1). Nu zonder taken (fase 7). Uitleg:
// docs/hosting.md. Wordt uitgerold met `wrangler deploy -c taken/wrangler.jsonc` (workflow uitrol).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ledenplatform-taken",
  "main": "worker.ts",
  // Gelijk aan wrangler.jsonc in de root; bij een update van wrangler beide meeschuiven.
  "compatibility_date": "2026-10-23",
  // Geen adres: niemand kan deze Worker aanroepen, ook niet via een versie-URL. Cloudflare start hem alleen volgens
  // de triggers.
  "workers_dev": false,
  "preview_urls": false,
  // Elke minuut: de berichten per mail versturen (taken/worker.ts). Zonder geheimen doet een run niets en schrijft hij één
  // regel in de logs; de berichten blijven dan staan tot ze na 24 uur verlopen. Geheimen zetten: docs/bouw/Berichten.md.
  "triggers": {
    "crons": ["* * * * *", "0 7 * * *"],
  },
  // Logs aan, anders dan bij de app-Worker: hier staan geen URL's met tokens in, alleen de eigen meldingen van de
  // taak (zonder persoonsgegevens). Zonder logs is de reden van een mislukte run nergens te zien (review PR12-03).
  "observability": {
    "enabled": true,
  },
  // Geheimen (dashboard, deze Worker, type Secret, nooit hier): SUPABASE_URL, SUPABASE_SECRET_KEY, POSTMARK_TOKEN,
  // BERICHT_AFZENDER, BERICHT_ONDERTEKENING en SITE_URL. Ook de gewone instellingen zijn Secret: een variabele van het type
  // Text haalt de volgende uitrol weg (docs/hosting.md). Niet bij de app-Worker (docs/hosting.md, Geheimen).
}
