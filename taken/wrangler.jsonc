// De taken-Worker: alleen geplande taken, zonder de Next-app (proefroute 3, Bouwbesluiten 3.1). Uitleg per keuze:
// docs/hosting.md. Wordt uitgerold met `wrangler deploy -c taken/wrangler.jsonc` (workflow uitrol).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ledenplatform-taken",
  "main": "worker.ts",
  // Gelijk aan wrangler.jsonc in de root; bij een update van wrangler beide meeschuiven.
  "compatibility_date": "2026-10-23",
  // Geen adres: niemand kan deze Worker aanroepen, ook niet via een versie-URL. Cloudflare start hem alleen volgens
  // de triggers.
  "workers_dev": false,
  "preview_urls": false,
  // Elke minuut: de geplande proeftaak (src/taken/proef-taak.ts). Na de proef: "crons": [] (een uitrol zonder
  // triggers laat de bestaande staan, review PR12-12), zie docs/hosting.md stap 12.
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Logs aan, anders dan bij de app-Worker: hier staan geen URL's met tokens in, alleen de eigen meldingen van de
  // taak (zonder persoonsgegevens). Zonder logs is de reden van een mislukte run nergens te zien (review PR12-03).
  "observability": {
    "enabled": true,
  },
  // SUPABASE_URL, SUPABASE_SECRET_KEY, RESEND_API_KEY, RESEND_AFZENDER en PROEF_TAAK_ONTVANGER staan als geheim bij
  // deze Worker (docs/hosting.md stap 12), niet hier en niet bij de app-Worker.
}
