// De taken-Worker: alleen geplande taken, zonder de Next-app (Bouwbesluiten 3.1). Nu zonder taken (fase 7). Uitleg:
// docs/hosting.md. Wordt uitgerold met `wrangler deploy -c taken/wrangler.jsonc` (workflow uitrol).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ledenplatform-taken",
  "main": "worker.ts",
  // Gelijk aan wrangler.jsonc in de root; bij een update van wrangler beide meeschuiven.
  "compatibility_date": "2026-10-23",
  // Geen adres: niemand kan deze Worker aanroepen, ook niet via een versie-URL. Cloudflare start hem alleen volgens
  // de triggers.
  "workers_dev": false,
  "preview_urls": false,
  // Geen geplande runs: er zijn nog geen taken (de proef van fase 0 is weg). Bewust een lege lijst en niet het blok
  // weghalen: een uitrol zonder triggers laat de bestaande staan (review PR12-12). In fase 7 hier een schema zetten.
  "triggers": {
    "crons": [],
  },
  // Logs aan, anders dan bij de app-Worker: hier staan geen URL's met tokens in, alleen de eigen meldingen van de
  // taak (zonder persoonsgegevens). Zonder logs is de reden van een mislukte run nergens te zien (review PR12-03).
  "observability": {
    "enabled": true,
  },
  // Geen geheimen nu (verwijderd 29-10-2026). In fase 7 komen SUPABASE_URL, SUPABASE_SECRET_KEY en de
  // Resend-gegevens als geheim bij déze Worker, niet hier en niet bij de app-Worker (docs/hosting.md, Geheimen).
}
