# Voorbeeld van de omgevingsvariabelen. Kopieer niet met de hand: `npm run env:lokaal` schrijft .env.local voor
# de lokale Supabase. Online staan de waarden als geheim bij Cloudflare (fase 0 stap E), nooit in de repository.
#
# Ze worden allemaal alleen op de server gelezen, bij elke aanvraag; er gaat niets naar de browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Het vaste adres van de site, voor de link in de inlogmail.
SITE_URL=
# Proefroute 1: het geheime token van de agenda-feed (/proef/agenda/<token>.ics). Minstens 32 tekens: letters,
# cijfers, - of _. Maak er een met: openssl rand -hex 32
PROEF_AGENDA_TOKEN=
