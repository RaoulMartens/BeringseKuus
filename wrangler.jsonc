// De Worker op Cloudflare (fase 0 stap E, Bouwbesluiten 3.1). OpenNext zet de Next-build om naar .open-next/;
// wrangler rolt die uit. Uitleg per keuze: docs/hosting.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledenplatform",
  // Eigen worker rond .open-next/worker.js, voor de geplande taak (proefroute 3).
  "main": "worker.ts",
  // Elke minuut: de geplande proeftaak (src/taken/proef-taak.ts). Na de proef terug naar een lagere frequentie of weg
  // (docs/hosting.md stap 12): elke run telt mee in de rekentijd en schrijft een rij.
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Gelijk aan de workerd-versie die bij wrangler hoort; bij een update van wrangler bewust meeschuiven.
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Alleen het vaste adres op workers.dev, geen eigen openbare URL per versie: anders blijft een oude versie met
  // een inmiddels gerepareerde fout bereikbaar (review PR8-05).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Geen Workers Logs: het log bewaart de volledige URL van elke aanvraag, en de inloglink en straks de
  // agenda-feed hebben een token in de URL (bouwgids 7.4). De rekentijd staat ook zonder logs in de metrics.
  "observability": {
    "enabled": false,
  },
  // SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SITE_URL, PROEF_AGENDA_TOKEN en die van de geplande taak
  // (SUPABASE_SECRET_KEY, RESEND_API_KEY, RESEND_AFZENDER, PROEF_TAAK_ONTVANGER) staan als geheim bij Cloudflare
  // (docs/hosting.md stap 5, 11 en 12), niet hier: deze repository is publiek en per omgeving verschillen ze.
}
