# Beveiligingsheaders voor de vaste bestanden (review PR8-04). Cloudflare serveert alles uit public/ en
# /_next/static/ zonder de Worker aan te roepen; de headers uit next.config.ts en src/middleware.ts komen daar niet mee.
# Een vast bestand voert nooit zelf code uit, dus de CSP staat niets toe. Precies gelijk aan
# headersVasteBestanden() in src/lib/beveiligingsheaders.ts; src/lib/beveiligingsheaders.test.ts bewaakt dat.
/*
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
