#!/bin/sh
# Vóór elke push: niets in de publieke repository wat er niet in hoort, en geen omwegen (bouwgids 14.1 en 14.4).
# Wat eenmaal gepusht is, is openbaar; de controle in GitHub komt pas daarna. Daarom draait hij ook hier.
# Overslaan met `git push --no-verify` telt als omweg.
#
# Git geeft deze hook op stdin per ref wat er gepusht wordt (lokale ref, lokale sha, remote ref, remote sha). Dat bewaren we eerst:
# de werkmap alleen is niet genoeg, want een gegeven dat in de ene commit komt en in de volgende weer weg is, staat na de push
# toch openbaar. Daarom wordt elke nieuwe commit ook als volledige map gecontroleerd.
invoer=$(cat)

npm run --silent controle:repo || {
  echo "Push gestopt: controle:repo vond een probleem (zie hierboven)." >&2
  exit 1
}
printf '%s\n' "$invoer" | node scripts/controleer-repo.ts --push || {
  echo "Push gestopt: een nieuwe commit voldoet niet aan de controle (zie hierboven). Gaat het om een persoonsgegeven of geheim, dan helpt verwijderen in een volgende commit niet: herschrijf de commit." >&2
  exit 1
}
npm run --silent controle:omwegen || {
  echo "Push gestopt: controle:omwegen vond een probleem (zie hierboven)." >&2
  exit 1
}
